# Copy to .env to override the defaults used by docker-compose.yml
DJANGO_ENV=development
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to POST the web forms when served behind an HTTPS proxy, e.g. https://*.app.github.dev
DJANGO_CSRF_TRUSTED_ORIGINS=
# Password of the demo users alice, bob and carol (not created when DJANGO_ENV=production)
DEMO_USERS_PASSWORD=demo1234
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
